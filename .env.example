# ── Jarvis Konfiguration ──────────────────────────────────────────────
# Kopiere diese Datei nach ".env" und trage deine Werte ein.

# Anthropic / Claude  (Pflicht – das "Superhirn")
# Key erstellen unter: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
JARVIS_MODEL=claude-opus-4-8

# Sprache der Antworten (z.B. "Deutsch", "English")
JARVIS_LANGUAGE=Deutsch

# Wie Jarvis dich anspricht
JARVIS_USER_NAME=Sir

# ── Home Assistant (optional) ─────────────────────────────────────────
# Long-Lived Access Token: HA Profil -> Sicherheit -> "Long-lived access tokens"
# URL OHNE abschliessenden Slash, z.B. http://homeassistant.local:8123
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# ── Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
